# Home Maidly - Production Environment Variables Example
# Duplicate this file to .env and configure real credentials for production

# Database configurations (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/homemaidly?schema=public"

# Redis Cache and Session storage URL
REDIS_URL="redis://localhost:6379"

# Authentication secret for JWT cookie/header verification
JWT_SECRET="generate-a-secure-random-secret-key-for-token-signatures"

# Payment Gateways configs (Active options: STRIPE, RAZORPAY, MOCK)
PAYMENT_PROVIDER="MOCK"

# Stripe config
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""

# Razorpay config
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Third-party communications APIs keys
SMS_PROVIDER_KEY=""
EMAIL_PROVIDER_KEY=""
MAP_PROVIDER_KEY=""

# Cloud Files Storage bucket (for KYC docs uploads)
STORAGE_BUCKET="homemaidly-kyc-files"
